# Flinch: API keys for running from source
# Copy this file to .env and fill in the keys for the models you want to test.
# The sidecar reads .env from the project root, or from the file FLINCH_ENV_FILE
# names, and Settings saves keys back to the same file. The desktop app keeps
# its keys in Windows Credential Manager instead and does not read this file.

# Anthropic (Claude models): the preferred provider for the coach and classifier
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (GPT models): optional, only needed if testing OpenAI targets
OPENAI_API_KEY=your-openai-api-key-here

# Google (Gemini models): optional, only needed if testing Gemini targets
GOOGLE_API_KEY=your-google-api-key-here

# xAI (Grok models): optional, only needed if testing Grok targets
XAI_API_KEY=your-xai-api-key-here

# Together AI (Llama models via Together): optional, only needed if testing Llama targets
TOGETHER_API_KEY=your-together-api-key-here

# Optional settings (uncomment to use)
# Ollama address for local models (Settings can change it)
# OLLAMA_BASE_URL=http://localhost:11434
# Hugging Face datasets API base for the HH-RLHF importer (tests point it at a stub)
# FLINCH_HF_API_BASE=

# FLINCH_ENV_FILE (which .env to use) and FLINCH_VARIANTS_DIR (folder for variant
# group files) are read before this file loads, so set them in the environment
# of the sidecar process, not here. See the README's "Sidecar options" table.
